# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Supabase CLI local cache (project ref, pooler connection details, etc.)
supabase/.temp/

# throwaway debug/simulation scripts — often contain hardcoded secrets
/scratch/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude / MCP local configuration
.mcp.json
.agents/