< 
<   IF v_seat.assigned_invitation_id IS NOT NULL AND v_seat.assigned_invitation_id <> p_invitation_id THEN
<     RETURN jsonb_build_object('success', false, 'error', 'Seat is already assigned to another guest.');
<   END IF;
< 
