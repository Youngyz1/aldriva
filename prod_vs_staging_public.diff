>                THEN event_row.event_at_text::timestamptz
>              ELSE NULL::timestamptz
>            END AS event_at
>       FROM event_source AS event_row
>   ),
>   -- Count completed deliveries per courier (delivered within range)
>   delivery_counts AS (
>     SELECT event_row.courier_worker_id,
