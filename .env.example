# ==============================================================================
# Standalone Fundraising Application — Environment Variables Example
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Media storage driver. Keep the server and browser values in sync.
IMAGE_STORAGE_DRIVER=supabase
NEXT_PUBLIC_IMAGE_STORAGE_DRIVER=supabase

# Cloudflare R2 media storage. Configure these outside source control.
# R2_BUCKET is public final images; R2_TMP_BUCKET is private temporary uploads;
# R2_PRIVATE_BUCKET stores private product files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_TMP_BUCKET=
R2_PRIVATE_BUCKET=
MEDIA_BASE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=

# Public image upload throttles and per-user UTC-day quota defaults.
# These apply only to R2-driver uploads; Supabase-driver uploads bypass them.
MEDIA_UPLOAD_USER_LIMIT=20
MEDIA_UPLOAD_USER_WINDOW_SECONDS=600
MEDIA_UPLOAD_IP_LIMIT=60
MEDIA_UPLOAD_IP_WINDOW_SECONDS=600
MEDIA_UPLOAD_DAILY_COUNT_LIMIT=40
MEDIA_UPLOAD_DAILY_BYTES_LIMIT=209715200

# Memories private photo storage driver: r2 (production default, uses
# R2_PRIVATE_BUCKET) or supabase (non-production default, private
# event-memories bucket from migration 162).
MEMORY_STORAGE_DRIVER=supabase

# Memories retention live-delete arm. Leave UNSET (or anything but "1"):
# the cron job dry-runs by default and live runs still delete nothing.
# ENABLE_MEMORY_RETENTION_DELETE=1

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend Transactional Email
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@aldriva.com

# Cron & Webhook Secrets
CRON_SECRET=your-cron-secret
SITE_WEBHOOK_SECRET=your-site-webhook-secret

# Stage 10 background-execution worker (Layer-1 shared secret + rotation
# overlap). Authorizes /api/exec/claim, /api/exec/heartbeat, /api/exec/run
# ONLY — result ingest requires the per-claim single-use token instead.
# Mint with: openssl rand -hex 32. Never commit a real value.
EXEC_WORKER_TOKEN=
EXEC_WORKER_TOKEN_PREV=

# Aldriva AI System Configuration
# ==============================================================================
# CONTENT_MODE controls what Growth Studio crons (daily-post, promotion-engine)
# generate. DELIBERATE MANUAL GATE — never auto-detected.
#   'platform_only' (DEFAULT — current target): About-Aldriva content only.
#     Grounded fundraiser/event paths are skipped entirely, because current DB
#     inventory is test/seed data, not real campaigns.
#   'grounded': historical behavior (pull real fundraisers/events).
#   'auto': grounded first, platform fallback only when nothing's available.
# IMPORTANT: manually switch to 'grounded' or 'auto' ONLY once the platform has
# real, non-test event/fundraiser inventory. Also set CONTENT_MODE=platform_only
# in Vercel (all environments) until then.
CONTENT_MODE=platform_only

# AI_PROVIDER_DEFAULT options: 'gemini' (default) or 'openrouter'
AI_PROVIDER_DEFAULT=gemini

# Google Gemini Settings (Default High-Volume Provider)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter Cloud Settings (Pluggable Cloud Provider)
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Facebook / Meta Graph API (Social Automation)
# ==============================================================================
# Page ID and long-lived Page Access Token from Meta Graph API Explorer v26.0
# Obtain via: GET https://graph.facebook.com/v26.0/me/accounts?access_token=<user_token>
FB_PAGE_ID=your-facebook-page-id
FB_PAGE_ACCESS_TOKEN=your-page-access-token
# Optional: override Graph API version (defaults to v26.0)
# FB_GRAPH_API_VERSION=v26.0
