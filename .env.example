# ==============================================================================
# Standalone Fundraising Application — Environment Variables Example
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend Transactional Email
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@aldriva.com

# Cron & Webhook Secrets
CRON_SECRET=your-cron-secret
SITE_WEBHOOK_SECRET=your-site-webhook-secret

# Aldriva AI System Configuration
# ==============================================================================
# AI_PROVIDER_DEFAULT options: 'gemini' (default) or 'openrouter'
AI_PROVIDER_DEFAULT=gemini

# Google Gemini Settings (Default High-Volume Provider)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter Cloud Settings (Pluggable Cloud Provider)
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Facebook / Meta Graph API (Social Automation)
# ==============================================================================
# Page ID and long-lived Page Access Token from Meta Graph API Explorer v26.0
# Obtain via: GET https://graph.facebook.com/v26.0/me/accounts?access_token=<user_token>
FB_PAGE_ID=your-facebook-page-id
FB_PAGE_ACCESS_TOKEN=your-page-access-token
# Optional: override Graph API version (defaults to v26.0)
# FB_GRAPH_API_VERSION=v26.0
